# Copy to .env and fill in. Loaded by dotenvy in main.rs.
# The API key is also used to build the WSS URL if helius_wss_url is omitted in whales.json.
HELIUS_API_KEY=your_helius_api_key_here

# Optional: override the WSS endpoint (defaults to Atlas mainnet built from the key).
# HELIUS_WSS_URL=wss://atlas-mainnet.helius-rpc.com/?api-key=your_helius_api_key_here

# Optional: path to the whales config (defaults to config/whales.json).
# WHALES_CONFIG_PATH=config/whales.json

# Optional log level for tracing-subscriber (e.g. info, debug, copytrade=debug).
RUST_LOG=info
