# Transaction source mode: WSS (beta) or GRPC (production)
MODE=WSS

# Helius API key for WebSocket transaction monitoring
HELIUS_API_KEY=YOUR_HELIUS_API_KEY_HERE

# Bot wallet private key (base58 encoded, 64 bytes)
# Generate: solana-keygen new --no-bip39-passphrase -o bot.json
PRIVATE_KEY_BOT=YOUR_PRIVATE_KEY_BASE58_HERE

# Solana RPC endpoint for transaction submission
RPC_URL=https://api.mainnet-beta.solana.com

# Optional: custom Helius WSS endpoint (auto-built from key if empty)
# HELIUS_WSS_URL=wss://atlas-mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Optional: Yellowstone gRPC (only needed when MODE=GRPC)
# GRPC_URL=https://your-shredstream-endpoint:10000
# GRPC_API_TOKEN=YOUR_TOKEN_HERE
